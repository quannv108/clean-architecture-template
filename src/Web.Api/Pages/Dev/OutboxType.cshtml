@page "/_dev/outbox/type"
@model Web.Api.Pages.Dev.OutboxTypeModel
@using System.Text.Json
@{
    Layout = null;

    string PrettyPrint(string content)
    {
        try
        {
            using var doc = JsonDocument.Parse(content);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return content;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Type — Outbox Errors</title>
    <style>
        :root {
            --bg: #0f1115;
            --panel: #171a21;
            --border: #262b36;
            --text: #e6e9ef;
            --muted: #8b93a3;
            --accent: #5b9dff;
            --bad: #e05a4f;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
        }
        .wrap { max-width: 1100px; margin: 0 auto; padding: 40px 24px 80px; }
        header { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
        h1 { font-size: 1.3rem; margin: 0; font-weight: 650; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; word-break: break-all; }
        .back { color: var(--accent); text-decoration: none; font-size: .85rem; }
        .back:hover { text-decoration: underline; }
        .subtitle { color: var(--muted); margin: 0 0 28px; font-size: .95rem; }
        .card {
            background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
            padding: 18px 20px; margin-bottom: 18px;
        }
        .card .meta { display: flex; gap: 18px; flex-wrap: wrap; font-size: .82rem; color: var(--muted); margin-bottom: 12px; }
        .card .meta strong { color: var(--text); }
        .card h3 { font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: var(--bad); margin: 14px 0 6px; }
        .card h3.content-label { color: var(--muted); }
        pre {
            background: #0b0d11; border: 1px solid var(--border); border-radius: 8px;
            padding: 12px 14px; overflow-x: auto; font-size: .82rem; margin: 0;
            white-space: pre-wrap; word-break: break-word;
        }
        .empty { color: var(--muted); padding: 24px; background: var(--panel); border: 1px solid var(--border); border-radius: 12px; }
        footer { color: var(--muted); font-size: .8rem; margin-top: 32px; }
    </style>
</head>
<body>
    <div class="wrap">
        <header>
            <h1>@Model.Type</h1>
        </header>
        <p class="subtitle">
            <a class="back" href="/_dev/outbox">&larr; back to outbox</a> · Most recent failures (up to 5).
        </p>

        @if (Model.Errors.Count == 0)
        {
            <div class="empty">No failures recorded for this type.</div>
        }
        else
        {
            @foreach (var error in Model.Errors)
            {
                <div class="card">
                    <div class="meta">
                        <span>Occurred: <strong>@error.OccurredOnUtc.ToString("u")</strong></span>
                        <span>Machine: <strong>@(error.ProcessedByMachine ?? "—")</strong></span>
                        <span>Id: <strong>@error.Id</strong></span>
                    </div>
                    <h3>Error</h3>
                    <pre>@error.Error</pre>
                    <h3 class="content-label">Content</h3>
                    <pre>@PrettyPrint(error.Content)</pre>
                </div>
            }
        }

        <footer>Clean Architecture template · this page is served only in the Development environment.</footer>
    </div>
</body>
</html>
